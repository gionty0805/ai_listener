# ---- 서버 ----
PORT=3000
# 접근 코드(선택). 설정 시 모든 API 호출에 x-access-token 헤더 필요
APP_ACCESS_TOKEN=
# 데이터 저장 경로
DATA_DIR=./data
# 공개 URL (이메일 본문 링크용)
PUBLIC_BASE_URL=http://localhost:3000
TZ=Asia/Seoul

# ---- 요약 (Claude) ----
# claude | mock  (미설정 시 ANTHROPIC_API_KEY 유무로 자동 결정)
SUMMARIZER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 최종 요약 / 청크 중간요약 effort (low|medium|high|xhigh|max)
CLAUDE_EFFORT_FINAL=high
CLAUDE_EFFORT_CHUNK=medium
# 거절(refusal) 시 서버측 자동 폴백 사용
CLAUDE_FALLBACKS=true

# ---- 청크 처리 ----
# 녹음 중 N분 단위로 중간요약 생성
CHUNK_MINUTES=10
# 청크 최대 글자수 (시간 기준보다 먼저 도달하면 분할)
CHUNK_MAX_CHARS=12000
# 전사문이 이 글자수 이하이면 최종 요약은 전체 원문 단일 패스
SINGLE_PASS_MAX_CHARS=200000
# 녹음 중 중간요약(라이브 노트) 생성 여부
LIVE_NOTES=true

# ---- 음성인식 (STT) ----
# browser: 브라우저 Web Speech API (무료, 실시간)
# whisper: 서버에서 OpenAI 호환 /v1/audio/transcriptions 엔드포인트 호출 (예: 사내 faster-whisper 서버)
STT_MODE=browser
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# 녹음 세그먼트 길이(초). 세그먼트마다 독립 파일로 업로드
AUDIO_SEGMENT_SECONDS=300
# 요약 완료 후 원본 음성 보관 여부 (기본: 삭제)
KEEP_AUDIO=false

# ---- 이메일 (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Listener <no-reply@example.com>
# 요약 완료 시 세션에 등록된 수신자에게 자동 발송
AUTO_SEND_EMAIL=false

# ---- 메신저 알림 (Webhook) ----
# slack | teams | generic
WEBHOOK_FORMAT=slack
WEBHOOK_URL=
AUTO_SEND_WEBHOOK=false

# ---- 보안 ----
# 운영(NODE_ENV=production)에서 APP_ACCESS_TOKEN 없이 기동하려면 명시적으로 true
ALLOW_NO_AUTH=false
# 메일 수신 허용 도메인 (쉼표 구분, 예: example.com,example.co.kr). 비우면 제한 없음
MAIL_ALLOWED_DOMAINS=
# 리버스 프록시 뒤에서 X-Forwarded-For 신뢰 (프록시 없이 직접 노출 시 false)
TRUST_PROXY=false
# IP당 분당 요청 한도 (전체 API / 요약·발송·세션 생성)
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_COSTLY_PER_MINUTE=6
# 세션당 상한 (디스크 고갈 방지)
MAX_TRANSCRIPT_LINES=20000
MAX_AUDIO_SEGMENTS=150
